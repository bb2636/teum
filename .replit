modules = ["nodejs-18", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5002
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "start"]
build = ["sh", "-c", "pnpm build && pnpm --filter @teum/server db:baseline && pnpm --filter @teum/server db:migrate"]

[userenv]

[userenv.shared]

[userenv.production]
FRONTEND_URL = "https://teum--iteraon.replit.app"
BACKEND_URL = "https://teum--iteraon.replit.app"
